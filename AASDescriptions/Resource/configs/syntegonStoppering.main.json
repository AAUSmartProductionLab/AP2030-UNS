     },
     "Transformation": {
      "value": "-- MQTT state leg: PackMLState and the occupation queue.\n-- An empty Lua table serializes as a JSON OBJECT ({}), so the queue is\n-- pre-serialized explicitly: an empty queue MUST land as [] (an array).\nfunction aimc_main(sources)\n    local st = sources.StationState\n    if st == nil then return {} end\n    local q = st.ProcessQueue\n    if type(q) ~= \"table\" then q = {} end\n    return {\n        PackMLState     = st.State,\n        OccupationState = (#q == 0) and \"[]\" or json.encode(q),\n    }\nend\n"
     }
    },
    {
     "id_short": "Halt",
     "Transformation": {
      "value": "-- Skill 'Halt' operation delegation (one-MC): the DMP receives the caller's\n-- operation invocation and packs it into the native command message sent to\n-- /CMD/Halt, keeping the correlation Uuid (replies pass through unchanged):\nfunction aimc_main(sources)\n    local op = sources.Halt\n    return {\n        Halt = {\n            Uuid = op.Uuid,\n        },\n    }\nend\n"
     },
     "Sources": {
      "value": [
