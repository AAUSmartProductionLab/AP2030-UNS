         }
        },
        "SinkId": {
         "value": "OccupationState"
        }
       }
      ]
     },
     "Transformation": {
      "value": "-- OPC UA state leg: the station's StationState node carries a JSON\n-- blob ({\"PackMLState\": ..., \"OccupationState\": [...]}) inside the\n-- canonical milo envelope ({value, status, timestamp}) \u2014 decode the\n-- value member before reading the fields. An empty Lua table serializes\n-- as a JSON OBJECT ({}), so the empty queue MUST land as the literal\n-- \"[]\". A NON-EMPTY queue rides as the list itself \u2014 the AAS writer\n-- JSON-string-encodes list values properly (a pre-encoded string would\n-- hit the string-wrap path and truncate).\nfunction aimc_main(sources)\n    local d = sources.StationState\n    if d == nil then return {} end\n    if type(d) == \"table\" and type(d.value) == \"string\" then\n        local ok, parsed = pcall(json.decode, d.value)\n        if ok and type(parsed) == \"table\" then d = parsed end\n    end\n    if type(d) ~= \"table\" or d.PackMLState == nil then return {} end\n    local q = d.OccupationState\n    if type(q) ~= \"table\" or next(q) == nil then\n        return {\n            PackMLState     = d.PackMLState,\n            OccupationState = \"[]\",\n        }\n    end\n    return {\n        PackMLState     = d.PackMLState,\n        OccupationState = q,\n    }\nend\n"
     }
    },
