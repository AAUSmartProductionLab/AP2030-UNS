       {
        "id_short": "OccupationState",
        "Sink": {
         "id_short": "Sink",
         "value": {
          "type_": "ModelReference",
          "key": [
           {
            "type_": "Submodel",
            "value": "{aas_id}/submodels/Variables"
           },
           {
            "type_": "Property",
            "value": "OccupationState"
           }
