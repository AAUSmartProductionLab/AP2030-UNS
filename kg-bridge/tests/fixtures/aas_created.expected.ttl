@prefix ns1: <https://admin-shell.io/aas/3/1/Identifiable/> .
@prefix ns2: <https://admin-shell.io/aas/3/1/AssetInformation/> .
@prefix ns3: <https://admin-shell.io/aas/3/1/AssetAdministrationShell/> .

<urn:kg:aas:urn%3Aaas%3Acreated> a <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
    ns3:assetInformation [ a <https://admin-shell.io/aas/3/1/AssetInformation> ;
            ns2:assetKind <https://admin-shell.io/aas/3/1/AssetKind/Instance> ] ;
    ns1:id "urn:aas:created" .

