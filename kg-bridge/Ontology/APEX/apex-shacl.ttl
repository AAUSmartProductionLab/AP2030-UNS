@prefix apex: <https://w3id.org/2026/apex/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/2026/apex/shacl>
  a owl:Ontology ;
  rdfs:comment "APEX SHACL constraints for n-ary predicate argument bindings." ;
  owl:imports <https://w3id.org/2026/apex/> .

apex:PredicateArgumentBindingShape
  a sh:NodeShape ;
  sh:targetClass apex:PredicateArgumentBinding ;
  sh:property [
    sh:path apex:argumentIndex ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:xone (
    [
      sh:property [
        sh:path apex:argumentObject ;
        sh:minCount 1 ;
        sh:maxCount 1
      ] ;
      sh:property [
        sh:path apex:argumentLiteral ;
        sh:maxCount 0
      ]
    ]
    [
      sh:property [
        sh:path apex:argumentLiteral ;
        sh:minCount 1 ;
        sh:maxCount 1
      ] ;
      sh:property [
        sh:path apex:argumentObject ;
        sh:maxCount 0
      ]
    ]
  ) .

apex:PredicateShape
  a sh:NodeShape ;
  sh:targetClass apex:Predicate ;
  sh:property [
    sh:path apex:hasArgumentBinding ;
    sh:class apex:PredicateArgumentBinding ;
    sh:minCount 1
  ] .
