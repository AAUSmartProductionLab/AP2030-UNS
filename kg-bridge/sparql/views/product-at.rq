PREFIX arso:  <https://w3id.org/2025/arso#>
PREFIX arsox: <https://w3id.org/aau-ra/arso-ext#>
PREFIX apex:  <https://w3id.org/2026/apex/>

CONSTRUCT {
  ?fact a apex:ProductAt ;
    apex:hasArgumentBinding ?arg1, ?arg2 .

  ?arg1 a apex:PredicateArgumentBinding ;
    apex:argumentIndex 1 ;
    apex:argumentObject ?aas .

  ?arg2 a apex:PredicateArgumentBinding ;
    apex:argumentIndex 2 ;
    apex:argumentLiteral ?location .
}
FROM <urn:kg:tbox>
FROM <urn:kg:abox>
WHERE {
  ?aas a arsox:ProductAssetAdministrationShell ;
    arso:hasSubmodel ?sm .

  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?sid ;
    apex:smElementValue ?location .

  BIND(STRBEFORE(STR(?sme), "/submodel-elements/") AS ?submodelIdStr)
  BIND(IRI(?submodelIdStr) AS ?smeSubmodel)
  FILTER(?smeSubmodel = ?sm)

  BIND(LCASE(STR(?sid)) AS ?sidLower)
  FILTER(?sidLower = "https://w3id.org/2026/apex/semantic/location/label")

  BIND(IRI(CONCAT("urn:kg:apex:product-at:", ENCODE_FOR_URI(SHA256(CONCAT(STR(?aas), "|", STR(?location)))))) AS ?fact)
  BIND(IRI(CONCAT(STR(?fact), ":arg1")) AS ?arg1)
  BIND(IRI(CONCAT(STR(?fact), ":arg2")) AS ?arg2)
}
