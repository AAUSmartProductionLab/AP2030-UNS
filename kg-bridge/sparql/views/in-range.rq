PREFIX arso:  <https://w3id.org/2025/arso#>
PREFIX arsox: <https://w3id.org/aau-ra/arso-ext#>
PREFIX apex:  <https://w3id.org/2026/apex/>
PREFIX css:   <http://www.w3id.org/hsu-aut/css#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?fact a apex:InRange ;
    apex:hasArgumentBinding ?arg1, ?arg2 .

  ?arg1 a apex:PredicateArgumentBinding ;
    apex:argumentIndex 1 ;
    apex:argumentObject ?resourceAas .

  ?arg2 a apex:PredicateArgumentBinding ;
    apex:argumentIndex 2 ;
    apex:argumentObject ?stationAas .
}
FROM <urn:kg:tbox>
FROM <urn:kg:abox>
WHERE {
  # Moving resource (shuttle/robot) -- has X/Y position data.
  ?resourceAas a arsox:ResourceAssetAdministrationShell ;
    arso:hasSubmodel ?resourceSm .

  ?resourceXNode a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?resourceXSid ; apex:smElementValue ?resourceXRaw .
  FILTER(LCASE(STR(?resourceXSid)) = "https://w3id.org/2026/apex/semantic/position/x")
  BIND(STRBEFORE(STR(?resourceXNode), "/submodel-elements/") AS ?resourceXSmStr)
  FILTER(IRI(?resourceXSmStr) = ?resourceSm)

  ?resourceYNode a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?resourceYSid ; apex:smElementValue ?resourceYRaw .
  FILTER(LCASE(STR(?resourceYSid)) = "https://w3id.org/2026/apex/semantic/position/y")
  BIND(STRBEFORE(STR(?resourceYNode), "/submodel-elements/") AS ?resourceYSmStr)
  FILTER(IRI(?resourceYSmStr) = ?resourceSm)

  OPTIONAL {
    ?resourceZNode a apex:MirroredSubmodelElement ;
      apex:smElementSemanticId ?resourceZSid ; apex:smElementValue ?resourceZRaw .
    FILTER(LCASE(STR(?resourceZSid)) = "https://w3id.org/2026/apex/semantic/position/z")
    BIND(STRBEFORE(STR(?resourceZNode), "/submodel-elements/") AS ?resourceZSmStr)
    FILTER(IRI(?resourceZSmStr) = ?resourceSm)
  }

  # Station -- identified by having capabilities/skills or by idShort.
  ?stationAas a arsox:ResourceAssetAdministrationShell ;
    arso:hasSubmodel ?stationSm .

  ?stationXNode a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?stationXSid ; apex:smElementValue ?stationXRaw .
  FILTER(LCASE(STR(?stationXSid)) = "https://w3id.org/2026/apex/semantic/position/x")
  BIND(STRBEFORE(STR(?stationXNode), "/submodel-elements/") AS ?stationXSmStr)
  FILTER(IRI(?stationXSmStr) = ?stationSm)

  ?stationYNode a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?stationYSid ; apex:smElementValue ?stationYRaw .
  FILTER(LCASE(STR(?stationYSid)) = "https://w3id.org/2026/apex/semantic/position/y")
  BIND(STRBEFORE(STR(?stationYNode), "/submodel-elements/") AS ?stationYSmStr)
  FILTER(IRI(?stationYSmStr) = ?stationSm)

  OPTIONAL {
    ?stationZNode a apex:MirroredSubmodelElement ;
      apex:smElementSemanticId ?stationZSid ; apex:smElementValue ?stationZRaw .
    FILTER(LCASE(STR(?stationZSid)) = "https://w3id.org/2026/apex/semantic/position/z")
    BIND(STRBEFORE(STR(?stationZNode), "/submodel-elements/") AS ?stationZSmStr)
    FILTER(IRI(?stationZSmStr) = ?stationSm)
  }

  # Distinguish station from robot: station has capabilities/skills, or its idShort marks it.
  OPTIONAL { ?stationAas css:providesCapability ?stationCap . }
  OPTIONAL { ?stationAas css:providesSkill ?stationSkill . }
  OPTIONAL { ?stationAas apex:aasIdShort ?stationIdShort . }

  FILTER(?resourceAas != ?stationAas)
  FILTER(STR(?resourceAas) < STR(?stationAas))
  FILTER(
    BOUND(?stationCap)
    || BOUND(?stationSkill)
    || (BOUND(?stationIdShort) && CONTAINS(LCASE(STR(?stationIdShort)), "station"))
    || (BOUND(?stationIdShort) && CONTAINS(LCASE(STR(?stationIdShort)), "system"))
    || (BOUND(?stationIdShort) && CONTAINS(LCASE(STR(?stationIdShort)), "camera"))
  )

  BIND(xsd:double(STR(?resourceXRaw)) AS ?resourceX)
  BIND(xsd:double(STR(?resourceYRaw)) AS ?resourceY)
  BIND(xsd:double(COALESCE(STR(?resourceZRaw), "0")) AS ?resourceZ)

  BIND(xsd:double(STR(?stationXRaw)) AS ?stationX)
  BIND(xsd:double(STR(?stationYRaw)) AS ?stationY)
  BIND(xsd:double(COALESCE(STR(?stationZRaw), "0")) AS ?stationZ)

  BIND((?resourceX - ?stationX) AS ?dx)
  BIND((?resourceY - ?stationY) AS ?dy)
  BIND((?resourceZ - ?stationZ) AS ?dz)
  BIND((?dx * ?dx) + (?dy * ?dy) + (?dz * ?dz) AS ?distanceSquared)
  FILTER(?distanceSquared <= 1.0)

  BIND(IRI(CONCAT("urn:kg:apex:in-range:", ENCODE_FOR_URI(SHA256(CONCAT(STR(?resourceAas), "|", STR(?stationAas), "|", STR(?distanceSquared)))))) AS ?fact)
  BIND(IRI(CONCAT(STR(?fact), ":arg1")) AS ?arg1)
  BIND(IRI(CONCAT(STR(?fact), ":arg2")) AS ?arg2)
}
