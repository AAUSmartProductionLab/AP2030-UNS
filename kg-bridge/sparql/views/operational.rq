PREFIX arso:  <https://w3id.org/2025/arso#>
PREFIX arsox: <https://w3id.org/aau-ra/arso-ext#>
PREFIX apex:  <https://w3id.org/2026/apex/>

CONSTRUCT {
  ?fact a apex:Operational ;
    apex:hasArgumentBinding ?arg1 .

  ?arg1 a apex:PredicateArgumentBinding ;
    apex:argumentIndex 1 ;
    apex:argumentObject ?aas .
}
FROM <urn:kg:tbox>
FROM <urn:kg:abox>
WHERE {
  ?aas a arsox:ResourceAssetAdministrationShell ;
    arso:hasSubmodel ?sm .

  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?sid ;
    apex:smElementValue ?rawValue .

  BIND(STRBEFORE(STR(?sme), "/submodel-elements/") AS ?submodelIdStr)
  BIND(IRI(?submodelIdStr) AS ?smeSubmodel)
  FILTER(?smeSubmodel = ?sm)

  BIND(LCASE(STR(?sid)) AS ?sidLower)
  BIND(LCASE(STR(?rawValue)) AS ?valueLower)
  BIND(UCASE(STR(?rawValue)) AS ?packmlState)
  FILTER(?sidLower = "https://w3id.org/2026/apex/semantic/state/operational")
  FILTER(?valueLower IN ("true", "1", "on", "run", "running", "execute", "executing") || ?packmlState = "EXECUTE")

  BIND(IRI(CONCAT("urn:kg:apex:operational:", ENCODE_FOR_URI(SHA256(STR(?aas))))) AS ?fact)
  BIND(IRI(CONCAT(STR(?fact), ":arg1")) AS ?arg1)
}
