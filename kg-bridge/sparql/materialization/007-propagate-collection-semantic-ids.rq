PREFIX apex: <https://w3id.org/2026/apex/>
PREFIX aas-key: <https://admin-shell.io/aas/3/1/Key/>
PREFIX aas-ref: <https://admin-shell.io/aas/3/1/Reference/>
PREFIX aas-sem: <https://admin-shell.io/aas/3/1/HasSemantics/>
PREFIX aas-smc: <https://admin-shell.io/aas/3/1/SubmodelElementCollection/>

# Propagate the parent SubmodelElementCollection's semanticId to apex leaf mirror nodes.
#
# BaSyx SME_UPDATED events do not carry the Property's semanticId, so
# apex:smElementSemanticId is never set on leaf nodes by event processing.
# However, the SM_CREATED full mirror stores the parent collection's semanticId
# via aas:HasSemantics/semanticId, and the parent is linked to the child via
# aas:SubmodelElementCollection/value.  This rule bridges the two representations.

WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?leafSme apex:smElementSemanticId ?semanticId .
}
WHERE {
  ?leafSme a apex:MirroredSubmodelElement .
  FILTER NOT EXISTS { ?leafSme apex:smElementSemanticId ?any . }

  ?parentNode aas-smc:value ?leafSme ;
              aas-sem:semanticId ?semRef .
  ?semRef     aas-ref:keys ?semKey .
  ?semKey     aas-key:value ?semanticId .
}
;
WITH {{ABOX_GRAPH_N3}}
DELETE {
  ?leafSme apex:smElementSemanticId ?semanticId .
}
WHERE {
  ?leafSme a apex:MirroredSubmodelElement ;
    apex:smElementSemanticId ?semanticId .
  FILTER NOT EXISTS {
    ?parentNode aas-smc:value ?leafSme ;
                aas-sem:semanticId ?semRef .
    ?semRef     aas-ref:keys ?semKey .
    ?semKey     aas-key:value ?semanticId .
  }
  FILTER NOT EXISTS { ?leafSme aas-sem:semanticId ?any . }
}
