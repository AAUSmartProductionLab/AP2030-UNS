PREFIX arso:      <https://w3id.org/2025/arso#>
PREFIX aas-shell: <https://admin-shell.io/aas/3/1/AssetAdministrationShell/>
PREFIX aas-ref:   <https://admin-shell.io/aas/3/1/Reference/>
PREFIX aas-key:   <https://admin-shell.io/aas/3/1/Key/>

# Derive arso:hasSubmodel from the py_aas_rdf full-mirror blank-node structure.
#
# BaSyx does not publish SM_REF_ADDED events, so the bridge cannot create
# arso:hasSubmodel from those events.  The AAS_CREATED event includes the full
# AAS model via to_rdf(), which stores submodel references as blank nodes under
# aas-shell:submodels.  Each blank node is a Reference with keys pointing to
# the submodel IRI as a literal.  This rule lifts those literals into a clean
# arso:hasSubmodel object-property triple.

WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?aas arso:hasSubmodel ?submodelIri .
}
WHERE {
  ?aas    aas-shell:submodels ?smRef .
  ?smRef  aas-ref:keys        ?key .
  ?key    aas-key:value       ?submodelId .
  BIND(IRI(STR(?submodelId)) AS ?submodelIri)
  FILTER NOT EXISTS { ?aas arso:hasSubmodel ?submodelIri . }
}
;
WITH {{ABOX_GRAPH_N3}}
DELETE {
  ?aas arso:hasSubmodel ?submodelIri .
}
WHERE {
  ?aas arso:hasSubmodel ?submodelIri .
  FILTER NOT EXISTS {
    ?aas    aas-shell:submodels ?smRef .
    ?smRef  aas-ref:keys        ?key .
    ?key    aas-key:value       ?submodelId .
    FILTER(STR(?submodelId) = STR(?submodelIri))
  }
}
