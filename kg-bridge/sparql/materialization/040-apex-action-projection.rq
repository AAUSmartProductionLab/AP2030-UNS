PREFIX apex: <https://w3id.org/2026/apex/>
PREFIX arso: <https://w3id.org/2025/arso#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# ── Helper: last key value for a ReferenceElement SME ─────────────────────────
# Reused pattern: ?lastKey is the ref-key node whose index is maximal (the last key).
# Used inline via subquery in each rule that needs it.

# ── Actions ───────────────────────────────────────────────────────────────────
# Project apex:Action identity from Domain.Actions.<Key> SME (semanticId = capability IRI).
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?action a apex:Action ;
    apex:sourceSemanticId ?actionSemanticId ;
    rdfs:label ?actionKey .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path ;
    apex:smElementSemanticId ?actionSemanticId .
  FILTER(REGEX(STR(?path), "^Domain\\.Actions\\.[^.]+$"))
  BIND(REPLACE(STR(?path), "^Domain\\.Actions\\.([^.]+)$", "$1") AS ?actionKey)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IRI(CONCAT("urn:kg:apex:action:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))) AS ?action)
  FILTER NOT EXISTS { ?action apex:sourceSemanticId ?actionSemanticId . }
}
;

# ── Processes (temporal) ──────────────────────────────────────────────────────
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?action a apex:Action, apex:TemporalProcess ;
    apex:sourceSemanticId ?actionSemanticId ;
    rdfs:label ?actionKey .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path ;
    apex:smElementSemanticId ?actionSemanticId .
  FILTER(REGEX(STR(?path), "^Domain\\.Processes\\.[^.]+$"))
  BIND(REPLACE(STR(?path), "^Domain\\.Processes\\.([^.]+)$", "$1") AS ?actionKey)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IRI(CONCAT("urn:kg:apex:process:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))) AS ?action)
  FILTER NOT EXISTS { ?action apex:sourceSemanticId ?actionSemanticId . }
}
;

# ── Events ────────────────────────────────────────────────────────────────────
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?action a apex:Action, apex:TemporalEvent ;
    apex:sourceSemanticId ?actionSemanticId ;
    rdfs:label ?actionKey .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path ;
    apex:smElementSemanticId ?actionSemanticId .
  FILTER(REGEX(STR(?path), "^Domain\\.Events\\.[^.]+$"))
  BIND(REPLACE(STR(?path), "^Domain\\.Events\\.([^.]+)$", "$1") AS ?actionKey)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IRI(CONCAT("urn:kg:apex:event:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))) AS ?action)
  FILTER NOT EXISTS { ?action apex:sourceSemanticId ?actionSemanticId . }
}
;

# ── Source AAS link ──────────────────────────────────────────────────────────
WITH {{ABOX_GRAPH_N3}}
INSERT { ?action apex:hasSourceAAS ?aas . }
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path .
  FILTER(
    REGEX(STR(?path), "^Domain\\.(Actions|Processes|Events)\\.[^.]+$")
  )
  BIND(REPLACE(STR(?path), "^Domain\\.(Actions|Processes|Events)\\.([^.]+)$", "$2") AS ?actionKey)
  BIND(IF(CONTAINS(STR(?path), ".Actions."), "action",
         IF(CONTAINS(STR(?path), ".Processes."), "process", "event")) AS ?kind)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IF(?kind = "action",
       IRI(CONCAT("urn:kg:apex:action:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))),
       IF(?kind = "process",
          IRI(CONCAT("urn:kg:apex:process:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))),
          IRI(CONCAT("urn:kg:apex:event:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey)))))
       )) AS ?action)
  ?aas arso:hasSubmodel ?submodelIri .
  FILTER(STRSTARTS(STR(?sme), CONCAT(STR(?submodelIri), "/submodel-elements/")))
  FILTER NOT EXISTS { ?action apex:hasSourceAAS ?aas . }
}
;

# ── SkillReference ────────────────────────────────────────────────────────────
# Domain.Actions.<Key>.SkillReference → last ref-key value = skill idShort.
WITH {{ABOX_GRAPH_N3}}
INSERT { ?action apex:skillReferenceKey ?skillKey . }
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path .
  FILTER(REGEX(STR(?path), "^Domain\\.Actions\\.[^.]+\\.SkillReference$"))
  BIND(REPLACE(STR(?path), "^Domain\\.Actions\\.([^.]+)\\.SkillReference$", "$1") AS ?actionKey)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IRI(CONCAT("urn:kg:apex:action:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))) AS ?action)
  # Get last key value (highest index).
  ?sme apex:hasRefKey ?lastKey .
  ?lastKey apex:refKeyValue ?skillKey ; apex:refKeyIndex ?maxIdx .
  FILTER NOT EXISTS {
    ?sme apex:hasRefKey ?other . ?other apex:refKeyIndex ?otherIdx .
    FILTER(?otherIdx > ?maxIdx)
  }
  FILTER NOT EXISTS { ?action apex:skillReferenceKey ?skillKey . }
}
;

# ── Action parameters ────────────────────────────────────────────────────────
# Domain.Actions.<Key>.Parameters[N] → parameter node with index, type ref, and whether it's a self-ref.
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?action apex:hasParameter ?param .
  ?param a apex:Parameter ;
    apex:parameterIndex ?paramIdx ;
    apex:parameterTypeRef ?typeRef ;
    apex:parameterIsSelfRef ?isSelfRef .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path ;
    apex:smElementRefType ?refType .
  FILTER(REGEX(STR(?path), "^Domain\\.Actions\\.[^.]+\\.Parameters\\[[0-9]+\\]$"))
  BIND(REPLACE(STR(?path), "^Domain\\.Actions\\.([^.]+)\\.Parameters\\[[0-9]+\\]$", "$1") AS ?actionKey)
  BIND(REPLACE(STR(?path), "^Domain\\.Actions\\.[^.]+\\.Parameters\\[([0-9]+)\\]$", "$1") AS ?paramIdxRaw)
  BIND(xsd:nonNegativeInteger(?paramIdxRaw) AS ?paramIdx)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IRI(CONCAT("urn:kg:apex:action:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))) AS ?action)
  BIND(IRI(CONCAT("urn:kg:apex:parameter:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey, "|", ?paramIdxRaw))))) AS ?param)
  # Last key value = type IRI (for ExternalReference) or AAS id (for ModelReference to self).
  ?sme apex:hasRefKey ?lastKey .
  ?lastKey apex:refKeyValue ?typeRef ; apex:refKeyIndex ?maxIdx .
  FILTER NOT EXISTS { ?sme apex:hasRefKey ?other . ?other apex:refKeyIndex ?otherIdx . FILTER(?otherIdx > ?maxIdx) }
  # Self-ref: ModelReference with a single AssetAdministrationShell key.
  ?sme apex:hasRefKey ?firstKey .
  ?firstKey apex:refKeyIndex 0 ; apex:refKeyType ?firstKeyType .
  BIND(IF(?refType = "ModelReference" && ?firstKeyType = "AssetAdministrationShell",
          "true"^^xsd:boolean, "false"^^xsd:boolean) AS ?isSelfRef)
  FILTER NOT EXISTS { ?param apex:parameterIndex ?paramIdx . }
}
;

# ── Conditions and effects (with parameter bindings) ─────────────────────────
# For each condition/effect term, project a constraint node linking:
#  - the predicate (by semantic ID via FluentReference last key or smElementSemanticId)
#  - the timing role (PreConditions → hasPrecondition, etc.)
#  - each argument (by action parameter index, from the term's Parameters[J] ref last key)
#
# Path patterns:
#   Conditions.PreConditions  → apex:hasPrecondition
#   Conditions.AtStartConditions → apex:hasAtStartCondition
#   Conditions.AtEndConditions  → apex:hasAtEndCondition
#   Conditions.OverAllConditions → apex:hasOverAllCondition
#   Effects.AtEndEffects         → apex:hasAtEndEffect
#   Effects.AtStartEffects       → apex:hasAtStartEffect

# Step 1: project FluentReference → predicate semantic ID + role edge
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?action ?role ?constraint .
  ?constraint a apex:ProjectedConstraint ;
    apex:sourceSemanticId ?predicateSid ;
    apex:constraintPath ?termPath .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path .
  FILTER(REGEX(STR(?path),
    "^Domain\\.(Actions|Processes|Events)\\.[^.]+\\.(Conditions|Effects)\\.[^.]+\\.[^.]+\\.FluentReference$"))

  BIND(REPLACE(STR(?path), "^Domain\\.(Actions|Processes|Events)\\.([^.]+)\\..*$", "$2") AS ?actionKey)
  BIND(IF(CONTAINS(STR(?path), "Domain.Actions."), "action",
         IF(CONTAINS(STR(?path), "Domain.Processes."), "process", "event")) AS ?kind)
  BIND(REPLACE(STR(?sme), "^(.*)/submodel-elements/.*$", "$1") AS ?submodelRoot)
  BIND(IF(?kind = "action",
       IRI(CONCAT("urn:kg:apex:action:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))),
       IF(?kind = "process",
          IRI(CONCAT("urn:kg:apex:process:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey))))),
          IRI(CONCAT("urn:kg:apex:event:", ENCODE_FOR_URI(SHA256(CONCAT(?submodelRoot, "|", ?actionKey)))))
       )) AS ?action)

  # term path = everything up to FluentReference
  BIND(REPLACE(STR(?path), "\\.FluentReference$", "") AS ?termPath)
  BIND(IRI(CONCAT("urn:kg:apex:constraint:", ENCODE_FOR_URI(SHA256(?termPath)))) AS ?constraint)

  # predicate semantic ID: last key of the FluentReference
  ?sme apex:hasRefKey ?lastKey .
  ?lastKey apex:refKeyValue ?predicateSid ; apex:refKeyIndex ?maxIdx .
  FILTER NOT EXISTS { ?sme apex:hasRefKey ?other . ?other apex:refKeyIndex ?otherIdx . FILTER(?otherIdx > ?maxIdx) }

  # timing role
  BIND(
    IF(CONTAINS(?termPath, ".Conditions.PreConditions."),         apex:hasPrecondition,
    IF(CONTAINS(?termPath, ".Conditions.AtStartConditions."),     apex:hasAtStartCondition,
    IF(CONTAINS(?termPath, ".Conditions.AtEndConditions."),       apex:hasAtEndCondition,
    IF(CONTAINS(?termPath, ".Conditions.OverAllConditions."),     apex:hasOverAllCondition,
    IF(CONTAINS(?termPath, ".Effects.AtStartEffects."),           apex:hasAtStartEffect,
    IF(CONTAINS(?termPath, ".Effects.AtEndEffects."),             apex:hasAtEndEffect,
                                                                   apex:hasEffect))))))
    AS ?role)

  FILTER NOT EXISTS { ?constraint apex:constraintPath ?termPath . }
}
;

# Step 2: project condition/effect parameter bindings (action param indices)
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?constraint apex:constraintArg ?argBinding .
  ?argBinding a apex:ConstraintArg ;
    apex:constraintArgPosition ?argPos ;
    apex:constraintArgActionParamIndex ?actionParamIdx .
}
WHERE {
  ?sme a apex:MirroredSubmodelElement ;
    apex:smElementPath ?path .
  FILTER(REGEX(STR(?path),
    "^Domain\\.(Actions|Processes|Events)\\.[^.]+\\.(Conditions|Effects)\\.[^.]+\\.[^.]+\\.Parameters\\[[0-9]+\\]$"))

  BIND(REPLACE(STR(?path), "\\.Parameters\\[[0-9]+\\]$", "") AS ?termPath)
  BIND(REPLACE(STR(?path), "^.*\\.Parameters\\[([0-9]+)\\]$", "$1") AS ?argPosRaw)
  BIND(xsd:nonNegativeInteger(?argPosRaw) AS ?argPos)
  BIND(IRI(CONCAT("urn:kg:apex:constraint:", ENCODE_FOR_URI(SHA256(?termPath)))) AS ?constraint)
  BIND(IRI(CONCAT("urn:kg:apex:carg:", ENCODE_FOR_URI(SHA256(CONCAT(?termPath, "|", ?argPosRaw))))) AS ?argBinding)

  # action param index: last key value of this ref (points to Parameters[N], last key = N as string)
  ?sme apex:hasRefKey ?lastKey .
  ?lastKey apex:refKeyValue ?actionParamIdxStr ; apex:refKeyIndex ?maxIdx .
  FILTER NOT EXISTS { ?sme apex:hasRefKey ?other . ?other apex:refKeyIndex ?otherIdx . FILTER(?otherIdx > ?maxIdx) }
  BIND(xsd:nonNegativeInteger(?actionParamIdxStr) AS ?actionParamIdx)

  FILTER NOT EXISTS { ?argBinding apex:constraintArgPosition ?argPos . }
}
