INSERT {
  ?aas a arso:HasParametersAAS .
}
WHERE {
  ?aas arso:hasParametersSubmodel ?sm .
  FILTER NOT EXISTS { ?aas a arso:HasParametersAAS . }
}
;
WITH {{ABOX_GRAPH_N3}}
DELETE {
  ?aas a arso:HasParametersAAS .
}
WHERE {
  ?aas a arso:HasParametersAAS .
  FILTER NOT EXISTS { ?aas arso:hasParametersSubmodel ?sm . }
}
;
