PREFIX arso:  <https://w3id.org/2025/arso#>
PREFIX arsox: <https://w3id.org/aau-ra/arso-ext#>

# Resource/Product/ProcessAssetAdministrationShell types are now set directly
# by the bridge projection on AAS_CREATED events — no derived rules needed.
WITH {{ABOX_GRAPH_N3}}
INSERT {
  ?aas a arso:HasOperationalDataAAS .
}
WHERE {
  ?aas arso:hasOperationalDataSubmodel ?sm .
  FILTER NOT EXISTS { ?aas a arso:HasOperationalDataAAS . }
}
;
WITH {{ABOX_GRAPH_N3}}
DELETE {
  ?aas a arso:HasOperationalDataAAS .
}
WHERE {
  ?aas a arso:HasOperationalDataAAS .
  FILTER NOT EXISTS { ?aas arso:hasOperationalDataSubmodel ?sm . }
}
;
