@prefix : <http://www.w3id.org/aau-ra/cssx#> .
@prefix css: <http://www.w3id.org/hsu-aut/css#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#    Product hierarchy classes
#################################################################

###  http://www.w3id.org/aau-ra/cssx#MIM8
:MIM8 rdf:type owl:Class ;
  rdfs:subClassOf css:Product ;
  rdfs:comment "MIM8 product class used for multi-instance order planning." .

###  http://www.w3id.org/aau-ra/cssx#HgH
:HgH rdf:type owl:Class ;
  rdfs:subClassOf css:Product ;
  rdfs:comment "Human Growth Hormone product class used in configurable orders." .
