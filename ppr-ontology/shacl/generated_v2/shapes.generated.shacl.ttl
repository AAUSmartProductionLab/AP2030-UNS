    rdfs:domain <https://admin-shell.io/aas/3/1/AssetInformation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Resource> .

<https://admin-shell.io/aas/3/1/AssetInformation/globalAssetId> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has global asset ID"^^xsd:string ;
    rdfs:comment "Global identifier of the asset the AAS is representing."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetInformation> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AssetInformation/specificAssetIds> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has specific asset IDs"^^xsd:string ;
    rdfs:comment "Additional domain-specific, typically proprietary identifier for the asset like e.g., serial number etc."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetInformation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/SpecificAssetId> .

