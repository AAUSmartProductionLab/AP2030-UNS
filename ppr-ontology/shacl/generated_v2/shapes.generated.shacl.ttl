owl:Ontology a rdfs:Resource .

<https://admin-shell.io/aas/3/1/> a rdfs:Resource,
        owl:Ontology ;
    rdfs:comment "This ontology represents the data model for the Asset Administration Shell according to the specification version V3.1."@en ;
    rdfs:isDefinedBy <https://admin-shell.io/aas/3/1/> ;
    owl:versionInfo "V3.1" .

<https://admin-shell.io/aas/3/1/AbstractLangString/language> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has language"^^xsd:string ;
    rdfs:comment "Language tag conforming to BCP 47"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AbstractLangString> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AbstractLangString/text> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has text"^^xsd:string ;
    rdfs:comment "Text in the 'language'"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AbstractLangString> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AdministrativeInformation/creator> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has creator"^^xsd:string ;
    rdfs:comment "The subject ID of the subject responsible for making the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AdministrativeInformation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/AdministrativeInformation/revision> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has revision"^^xsd:string ;
    rdfs:comment "Revision of the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AdministrativeInformation> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AdministrativeInformation/templateId> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has template ID"^^xsd:string ;
    rdfs:comment "Identifier of the template that guided the creation of the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AdministrativeInformation> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AdministrativeInformation/version> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has version"^^xsd:string ;
    rdfs:comment "Version of the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AdministrativeInformation> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AnnotatedRelationshipElement/annotations> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has annotations"^^xsd:string ;
    rdfs:comment "A data element that represents an annotation that holds for the relationship between the two elements"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AnnotatedRelationshipElement> ;
    rdfs:range <https://admin-shell.io/aas/3/1/DataElement> .

<https://admin-shell.io/aas/3/1/AssetAdministrationShell/assetInformation> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has asset information"^^xsd:string ;
    rdfs:comment "Meta-information about the asset the AAS is representing."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
    rdfs:range <https://admin-shell.io/aas/3/1/AssetInformation> .

<https://admin-shell.io/aas/3/1/AssetAdministrationShell/derivedFrom> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has derived from"^^xsd:string ;
    rdfs:comment "The reference to the AAS the AAS was derived from."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/AssetAdministrationShell/submodels> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has submodels"^^xsd:string ;
    rdfs:comment "References to submodels of the AAS."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/AssetInformation/assetKind> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has asset kind"^^xsd:string ;
    rdfs:comment "Denotes whether the Asset is of kind 'Type' or 'Instance'."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetInformation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/AssetKind> .

<https://admin-shell.io/aas/3/1/AssetInformation/assetType> a rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "has asset type"^^xsd:string ;
    rdfs:comment "In case 'assetKind' is applicable the 'assetType' is the asset ID of the type asset of the asset under consideration as identified by 'globalAssetId'."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AssetInformation> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/AssetInformation/defaultThumbnail> a rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "has default thumbnail"^^xsd:string ;
