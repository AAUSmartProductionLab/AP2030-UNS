        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasKind>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Identifiable>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/Submodel> ;
    sh:property <https://w3id.org/2025/cssx#CapabilitiesSubmodel-https___admin-shell.io_aas_3_1_Submodel_submodelElements> .

<https://w3id.org/2025/cssx#CapabilitySMC> a rdfs:Class,
        rdfs:Resource,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC Capability entry. Must have a semanticId." ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#RealizedByRef> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> ],
        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/SubmodelElement>,
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:property <https://w3id.org/2025/cssx#CapabilitySMC-https___admin-shell.io_aas_3_1_HasSemantics_semanticId>,
        <https://w3id.org/2025/cssx#CapabilitySMC-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value> .

<https://w3id.org/2025/cssx#CapabilitySetSMC> a rdfs:Class,
        rdfs:Resource,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC CapabilitySet container." ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#CapabilitySMC> ],
        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/SubmodelElement>,
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:property <https://w3id.org/2025/cssx#CapabilitySetSMC-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value> .

<https://w3id.org/2025/cssx#Datapoint> a rdfs:Class,
        rdfs:Resource,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "A domain-specific measurement or value, represented as an AAS Property." ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:hasValue <https://admin-shell.io/aas/3/1/DataTypeDefXsd/Decimal> ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Property/valueType> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> ],
        <https://admin-shell.io/aas/3/1/DataElement>,
        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Property>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/SubmodelElement> ;
    sh:property <https://w3id.org/2025/cssx#Datapoint-https___admin-shell.io_aas_3_1_HasSemantics_semanticId>,
        <https://w3id.org/2025/cssx#Datapoint-https___admin-shell.io_aas_3_1_Property_value>,
        <https://w3id.org/2025/cssx#Datapoint-https___admin-shell.io_aas_3_1_Property_valueType> .

<https://w3id.org/2025/cssx#DatapointGroup> a rdfs:Class,
        rdfs:Resource,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "A structured group of Datapoints." ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/2025/cssx#Datapoint> ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/SubmodelElement>,
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:property <https://w3id.org/2025/cssx#DatapointGroup-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value> .

<https://w3id.org/2025/cssx#DigitalNameplateSubmodel> a rdfs:Class,
        rdfs:Resource,
        owl:Class,
        sh:NodeShape ;
    rdfs:label "Digital Nameplate Submodel" ;
    rdfs:comment "IDTA 02006 — Digital Nameplate for Industrial Equipment." ;
    rdfs:subClassOf [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#ManufacturerNameMLP> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#ManufacturerProductDesignationMLP> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#ContactInformationSMC> ],
        [ a rdfs:Resource,
                owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
            owl:someValuesFrom <https://w3id.org/2025/cssx#OrderCodeProperty> ],
        <https://admin-shell.io/aas/3/1/HasDataSpecification>,
        <https://admin-shell.io/aas/3/1/HasExtensions>,
        <https://admin-shell.io/aas/3/1/HasKind>,
        <https://admin-shell.io/aas/3/1/HasSemantics>,
        <https://admin-shell.io/aas/3/1/Identifiable>,
        <https://admin-shell.io/aas/3/1/Qualifiable>,
        <https://admin-shell.io/aas/3/1/Referable>,
        <https://admin-shell.io/aas/3/1/Submodel> ;
    sh:property <https://w3id.org/2025/cssx#DigitalNameplateSubmodel-https___admin-shell.io_aas_3_1_Submodel_submodelElements> .

<https://w3id.org/2025/cssx#EndpointMetadataSMC> a rdfs:Class,
