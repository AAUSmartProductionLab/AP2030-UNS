<https://w3id.org/2025/cssx> a rdfs:Resource,
        owl:Ontology ;
    rdfs:comment """CSSx v0.4 — Domain extension ontology for Resource AAS.\r
\r
  This ontology:\r
    - imports the official AAS v3.1 ontology for structural validation\r
    - defines domain-specific submodel types as subclasses of aas:Submodel\r
    - defines domain-specific SMEs as subclasses of AAS element types\r
    - expresses all domain constraints in OWL for owl2shacl derivation\r
    - uses AAS properties (submodelElements, value, etc.) for containment\r
    - adds cssx: properties only for cross-submodel dependency checks\r
\r
  Structural/formatting validation is handled by the AAS ontology + SHACL.\r
  This ontology adds ONLY domain-specific constraints on top.""" ;
    owl:imports <https://admin-shell.io/aas/3/1/> ;
    owl:versionIRI <https://w3id.org/2025/cssx/0.4.0> .

<https://w3id.org/2025/cssx#ActionsSMC> a rdfs:Resource,
