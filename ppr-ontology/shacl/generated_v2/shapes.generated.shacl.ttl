    owl:intersectionOf [ a rdfs:Resource ;
            rdf:first <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
            rdf:rest [ a rdfs:Resource ;
                    rdf:first [ a rdfs:Resource,
                                owl:Restriction ;
                            owl:onProperty <https://w3id.org/2025/cssx#hasSubmodel> ;
                            owl:someValuesFrom <https://w3id.org/2025/cssx#SkillsSubmodel> ] ;
                    rdf:rest () ] ] .

